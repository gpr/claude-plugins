{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/outline-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script ${CLAUDE_PLUGIN_ROOT}/scripts/outline.py --warm",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
