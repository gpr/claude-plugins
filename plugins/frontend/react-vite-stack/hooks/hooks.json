{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/enforce-pnpm.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-changed.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "src/routes/**/*.tsx",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/regen-routetree.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
