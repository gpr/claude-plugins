{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/task-index.sh"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "(?i)\\b(task|taskfile|bump|release|cog)\\b",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/task-index.sh --short"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pm-guard.sh"
        }
      ]
    }
  ]
}
